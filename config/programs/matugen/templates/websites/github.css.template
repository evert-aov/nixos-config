@-moz-document domain("github.com") {
    :root, [data-color-mode="dark"], [data-dark-theme="dark"] {
        --bgColor-default: {{colors.background.dark.hex}} !important;
        --bgColor-muted: {{colors.surface_container_low.dark.hex}} !important;
        --bgColor-inset: {{colors.surface_container_lowest.dark.hex}} !important;
        --bgColor-emphasis: {{colors.surface_bright.dark.hex}} !important;

        /* Borders */
        --borderColor-default: {{colors.outline_variant.dark.hex}} !important;
        --borderColor-muted: {{colors.outline_variant.dark.hex}} !important;
        --borderColor-emphasis: {{colors.outline.dark.hex}} !important;

        /* Text Colors */
        --fgColor-default: {{colors.on_surface.dark.hex}} !important;
        --fgColor-muted: {{colors.on_surface_variant.dark.hex}} !important;
        --fgColor-accent: {{colors.primary.dark.hex}} !important;

        /* Buttons */
        --button-primary-bgColor-rest: {{colors.primary.dark.hex}} !important;
        --button-primary-fgColor-rest: {{colors.on_primary.dark.hex}} !important;
        --button-primary-bgColor-hover: {{colors.primary_fixed_dim.dark.hex}} !important;
        --button-primary-bgColor-active: {{colors.primary_fixed.dark.hex}} !important;
        --button-primary-borderColor-rest: {{colors.outline_variant.dark.hex}} !important;

        --button-default-bgColor-rest: {{colors.surface_container_high.dark.hex}} !important;
        --button-default-fgColor-rest: {{colors.on_surface.dark.hex}} !important;
        --button-default-bgColor-hover: {{colors.surface_bright.dark.hex}} !important;
        --buttonCounter-default-bgColor-rest: {{colors.surface_container_highest.dark.hex}} !important;

        --bgColor-accent-emphasis: {{colors.primary.dark.hex}} !important;
        --borderColor-accent-emphasis: {{colors.primary.dark.hex}} !important;
        --bgColor-accent-muted: {{colors.primary_container.dark.hex}} !important;
        --borderColor-accent-muted: {{colors.primary_container.dark.hex}} !important;

        --bgColor-danger-emphasis: {{colors.error.dark.hex}} !important;
        --fgColor-danger: {{colors.error.dark.hex}} !important;
        --button-danger-fgColor-rest: {{colors.error.dark.hex}} !important;
        --button-danger-bgColor-hover: {{colors.error_container.dark.hex}} !important;

        --bgColor-attention-emphasis: {{colors.secondary.dark.hex}} !important;
        --borderColor-attention-muted: {{colors.secondary_container.dark.hex}} !important;

        --control-checked-bgColor-rest: {{colors.primary.dark.hex}} !important;
        --control-checked-bgColor-hover: {{colors.primary_fixed_dim.dark.hex}} !important;
        --control-checked-bgColor-active: {{colors.primary_fixed.dark.hex}} !important;

        /* Star button */
        --button-star-iconColor: {{colors.primary.dark.hex}} !important;

        /* Hovered button color */
        --control-bgColor-active: {{colors.surface_container_highest.dark.hex}} !important;

        /* Profile popout color */
        --overlay-bgColor: {{colors.surface_container.dark.hex}} !important;
    }
}

@media (prefers-color-scheme: light) {
    @-moz-document domain("github.com") {
        :root, [data-color-mode="light"], [data-light-theme="light"] {
            --bgColor-default: {{colors.background.light.hex}} !important;
            --bgColor-muted: {{colors.surface_container_low.light.hex}} !important;
            --bgColor-inset: {{colors.surface_container_lowest.light.hex}} !important;
            --bgColor-emphasis: {{colors.surface_bright.light.hex}} !important;

            /* Borders */
            --borderColor-default: {{colors.outline_variant.light.hex}} !important;
            --borderColor-muted: {{colors.outline_variant.light.hex}} !important;
            --borderColor-emphasis: {{colors.outline.light.hex}} !important;

            /* Text Colors */
            --fgColor-default: {{colors.on_surface.light.hex}} !important;
            --fgColor-muted: {{colors.on_surface_variant.light.hex}} !important;
            --fgColor-accent: {{colors.primary.light.hex}} !important;

            /* Buttons */
            --button-primary-bgColor-rest: {{colors.primary.light.hex}} !important;
            --button-primary-fgColor-rest: {{colors.on_primary.light.hex}} !important;
            --button-primary-bgColor-hover: {{colors.primary_fixed_dim.light.hex}} !important;
            --button-primary-bgColor-active: {{colors.primary_fixed.light.hex}} !important;
            --button-primary-borderColor-rest: {{colors.outline_variant.light.hex}} !important;

            --button-default-bgColor-rest: {{colors.surface_container_high.light.hex}} !important;
            --button-default-fgColor-rest: {{colors.on_surface.light.hex}} !important;
            --button-default-bgColor-hover: {{colors.surface_bright.light.hex}} !important;
            --buttonCounter-default-bgColor-rest: {{colors.surface_container_highest.light.hex}} !important;

            --bgColor-accent-emphasis: {{colors.primary.light.hex}} !important;
            --borderColor-accent-emphasis: {{colors.primary.light.hex}} !important;
            --bgColor-accent-muted: {{colors.primary_container.light.hex}} !important;
            --borderColor-accent-muted: {{colors.primary_container.light.hex}} !important;

            --bgColor-danger-emphasis: {{colors.error.light.hex}} !important;
            --fgColor-danger: {{colors.error.light.hex}} !important;
            --button-danger-fgColor-rest: {{colors.error.light.hex}} !important;
            --button-danger-bgColor-hover: {{colors.error_container.light.hex}} !important;

            --bgColor-attention-emphasis: {{colors.secondary.light.hex}} !important;
            --borderColor-attention-muted: {{colors.secondary_container.light.hex}} !important;

            --control-checked-bgColor-rest: {{colors.primary.light.hex}} !important;
            --control-checked-bgColor-hover: {{colors.primary_fixed_dim.light.hex}} !important;
            --control-checked-bgColor-active: {{colors.primary_fixed.light.hex}} !important;

            /* Star button */
            --button-star-iconColor: {{colors.primary.light.hex}} !important;

            /* Hovered button color */
            --control-bgColor-active: {{colors.surface_container_highest.light.hex}} !important;

            /* Profile popout color */
            --overlay-bgColor: {{colors.surface_container.light.hex}} !important;
        }
    }
}
