[manager]
preview = { fg = "{{colors.on_surface.default.hex}}", bg = "{{colors.surface_container_lowest.default.hex}}" }
preview_border = { fg = "{{colors.outline_variant.default.hex}}" }
cwd = { fg = "{{colors.primary.default.hex}}", bold = true }
hovered = { fg = "{{colors.on_secondary_container.default.hex}}", bg = "{{colors.secondary_container.default.hex}}" }
tab_active = { fg = "{{colors.on_primary_container.default.hex}}", bg = "{{colors.primary_container.default.hex}}" }
tab_inactive = { fg = "{{colors.on_surface_variant.default.hex}}", bg = "{{colors.surface_container.default.hex}}" }

[status]
separator_style = { fg = "{{colors.outline_variant.default.hex}}" }
separator_open = "┃"
separator_close = "┃"

[input]
border = { fg = "{{colors.outline.default.hex}}" }
title = { fg = "{{colors.primary.default.hex}}" }
value = { fg = "{{colors.on_surface.default.hex}}" }

[select]
border = { fg = "{{colors.primary.default.hex}}" }
active = { fg = "{{colors.on_primary.default.hex}}", bg = "{{colors.primary.default.hex}}" }
inactive = { fg = "{{colors.on_surface.default.hex}}" }

[tasks]
border = { fg = "{{colors.secondary.default.hex}}" }
title = { fg = "{{colors.on_surface.default.hex}}" }
hovered = { fg = "{{colors.on_secondary_container.default.hex}}", bg = "{{colors.secondary_container.default.hex}}" }

[which]
mask = { bg = "{{colors.surface_container.default.hex}}" }
cand = { fg = "{{colors.primary.default.hex}}" }
rest = { fg = "{{colors.secondary.default.hex}}" }
desc = { fg = "{{colors.tertiary.default.hex}}" }
cols = 3

[help]
border = { fg = "{{colors.outline.default.hex}}" }
desc = { fg = "{{colors.on_surface.default.hex}}" }
hovered = { fg = "{{colors.on_secondary_container.default.hex}}", bg = "{{colors.secondary_container.default.hex}}" }

[completion]
border = { fg = "{{colors.outline.default.hex}}" }
active = { fg = "{{colors.on_primary.default.hex}}", bg = "{{colors.primary.default.hex}}" }
hovered = { fg = "{{colors.on_secondary_container.default.hex}}", bg = "{{colors.secondary_container.default.hex}}" }

[notify]
title_info = { fg = "{{colors.primary.default.hex}}" }
title_warn = { fg = "{{colors.tertiary.default.hex}}" }
title_error = { fg = "{{colors.error.default.hex}}" }
