{
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry"
    }
  },
  "agent": {
    "always_allow_tool_actions": false,
    "default_profile": "write",
    "tool_permissions": {
      "default": "confirm",
      "tools": {
        "terminal": {
          "default": "confirm"
        }
      }
    }
  },
  "vim_mode": true,
  "base_keymap": "Zed",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "Matugen Light",
    "dark": "Matugen Dark"
  },
  "format_on_save": "on",
  "languages": {
    "Python": {
      "language_servers": [
        "pyright",
        "ruff"
      ],
      "formatter": {
        "language_server": {
          "name": "ruff"
        }
      },
      "code_actions_on_format": {
        "source.organizeImports": true
      }
    }
  },
  "lsp": {
    "pyright": {
      "settings": {
        "python.analysis": {
          "typeCheckingMode": "basic",
          "autoSearchPaths": true,
          "useLibraryCodeForTypes": true
        }
      }
    }
  }
}

